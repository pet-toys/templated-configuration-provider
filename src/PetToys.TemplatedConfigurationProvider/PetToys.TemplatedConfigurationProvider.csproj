<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworkVersions)</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <PropertyGroup Label="NuGet package">
    <Description>An IConfigurationProvider for .NET that expands {placeholder} references between configuration keys - keep secrets in environment variables, user secrets, or a key vault and template them into appsettings.json at runtime.</Description>
    <PackageTags>configuration;configuration-provider;microsoft-extensions-configuration;appsettings;placeholder;templating;interpolation;secrets;aspnetcore</PackageTags>
    <PackageReleaseNotes>(Please write the package release notes in "RELEASE-NOTES.txt".)</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\icon.png" Pack="true" Visible="false" PackagePath="/" />
    <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="/" />
  </ItemGroup>

  <PropertyGroup>
    <ReleaseNotesFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', '..', 'assets', 'RELEASE-NOTES.txt'))</ReleaseNotesFile>
    <!-- RELEASE-NOTES.txt is a cumulative changelog, newest version on top,
         versions separated by a line of 3+ hyphens. Publish only the top
         section. Read verbatim (not ReadLinesFromFile, which drops blank lines
         and strips the indentation of wrapped bullets). -->
    <ReleaseNotesSeparatorPattern>(?s)\A.*?(?=\r?\n[ \t]*-{3,}[ \t]*\r?\n|\z)</ReleaseNotesSeparatorPattern>
    <!-- Leading version header (version line + '=' underline + blank lines).
         Stripped from the published notes; it lives only in RELEASE-NOTES.txt
         (NuGet and the GitHub release already show the version). -->
    <ReleaseNotesHeaderPattern>\A[^\r\n]*\r?\n=+[ \t]*\r?\n\s*</ReleaseNotesHeaderPattern>
  </PropertyGroup>

  <Target Name="PreparePackageReleaseNotesFromFile" BeforeTargets="GenerateNuspec"
          Condition="Exists('$(ReleaseNotesFile)')">
    <PropertyGroup>
      <_ReleaseNotesTopSection>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(ReleaseNotesFile)')), '$(ReleaseNotesSeparatorPattern)').Value)</_ReleaseNotesTopSection>
      <PackageReleaseNotes>$([System.Text.RegularExpressions.Regex]::Replace($(_ReleaseNotesTopSection), '$(ReleaseNotesHeaderPattern)', '').TrimEnd())</PackageReleaseNotes>
    </PropertyGroup>
  </Target>

  <!-- A published package must carry real notes, so pack fails rather than ship
       the placeholder or an empty section. Build is unaffected: GenerateNuspec
       only runs when a package is produced. -->
  <Target Name="ValidatePackageReleaseNotes" BeforeTargets="GenerateNuspec"
          DependsOnTargets="PreparePackageReleaseNotesFromFile">
    <Error Condition="'$(PackageReleaseNotes)' == ''"
           Code="PT0001"
           Text="The top section of '$(ReleaseNotesFile)' is empty. Describe this release at the top of the file (newest version first, sections separated by a line of 3+ hyphens) before packing." />
    <Error Condition="$(PackageReleaseNotes.Contains('Please write the package release notes'))"
           Code="PT0001"
           Text="The package release notes are still the placeholder, so '$(ReleaseNotesFile)' was not read or has no usable top section. Describe this release at the top of that file before packing." />
  </Target>

  <!-- Preview the notes the package will carry:
       dotnet msbuild <project> -t:ExportPackageReleaseNotes
       The destination defaults into obj/, so no caller has to invent a path:
       MSBuild roots a POSIX one, which is what a Git Bash shell hands it, on
       the current drive, and the file lands outside the repository.
       CI overrides the property and reads the GitHub release body from it. -->
  <Target Name="ExportPackageReleaseNotes" DependsOnTargets="PreparePackageReleaseNotesFromFile">
    <PropertyGroup Condition="'$(ReleaseNotesExportPath)' == ''">
      <ReleaseNotesExportPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'release-notes.txt'))</ReleaseNotesExportPath>
    </PropertyGroup>
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(ReleaseNotesExportPath)'))" />
    <WriteLinesToFile File="$(ReleaseNotesExportPath)" Lines="$(PackageReleaseNotes)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Message Importance="high" Text="Release notes exported to $(ReleaseNotesExportPath)" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="PetToys.TemplatedConfigurationProvider.Tests" />
  </ItemGroup>

</Project>
