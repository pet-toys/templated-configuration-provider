<Project>
  <PropertyGroup>
    <FrameworkVersion Condition="'$(TargetFramework)' == 'net8.0'">[8.0.0,9.0.0)</FrameworkVersion>
    <FrameworkVersion Condition="'$(TargetFramework)' == 'net9.0'">[9.0.4,10.0.0)</FrameworkVersion>
    <FrameworkVersion Condition="'$(TargetFramework)' == 'net10.0'">[10.0.0,11.0.0)</FrameworkVersion>
    <FrameworkExtVersion>[8.0.0,11.0.0)</FrameworkExtVersion>
    <RoslinatorVersion>[4.14.1,)</RoslinatorVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(FrameworkExtVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="$(FrameworkExtVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="$(FrameworkExtVersion)" />
  </ItemGroup>
  <ItemGroup>
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="[8.0.0,)" />
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="$(RoslinatorVersion)" />
    <GlobalPackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="$(RoslinatorVersion)" />
    <GlobalPackageReference Include="Roslynator.CodeFixes" Version="$(RoslinatorVersion)" />
    <GlobalPackageReference Include="Roslynator.Formatting.Analyzers" Version="$(RoslinatorVersion)" />
    <GlobalPackageReference Include="Roslynator.Refactorings" Version="$(RoslinatorVersion)" />
  </ItemGroup>
</Project>